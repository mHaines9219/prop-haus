{
  "name": "prop-haus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "astryx": {
    "theme": "stone"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scrape:merge": "tsx scrapers/merge.ts",
