    "db:dump": "tsx scripts/dump-catalog.ts",
    "eval:search": "tsx --env-file=.env.local scripts/eval-search.ts",
    "eval:scenes": "tsx --env-file=.env.local scripts/eval-scenes.ts",
    "eval:enrichment": "tsx --env-file=.env.local scripts/eval-enrichment-lift.ts",
    "eval:relevance": "tsx --env-file=.env.local scripts/eval-relevance.ts",
