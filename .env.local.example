# Copy to .env.local and fill in.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model. Defaults to openai/gpt-4o-mini.
# Cheap/fast picks: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: shown to OpenRouter for analytics / rate-limit attribution.
OPENROUTER_SITE_URL=http://localhost:3017
OPENROUTER_APP_NAME=prop-haus

# ---------------------------------------------------------------------------
# FUT-2 · Spacelab 3D set preview
#
# All optional. With none of these set the flow still works end to end: models
# are photo-mapped boxes generated locally, and the order page offers the room
# file for download (Spacelab's own "import room" button reads it).
# ---------------------------------------------------------------------------

# Where Spacelab is deployed, e.g. https://spacelab.vercel.app. Until this is
# set, the order page offers the room file instead of a deep link.
# Spacelab also needs the remote-catalog patch in docs/spacelab-integration.md.
NEXT_PUBLIC_SPACELAB_URL=

# Our own origin, used for the absolute URLs handed to Spacelab (it fetches the
# room and the meshes cross-origin, so a relative path is useless there).
# Falls back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Image-to-3D generator. 'mock' (the default) builds a correctly sized box
# wearing the item's photo — no key, no cost, loads in Spacelab like any model.
# A real service is one adapter file in lib/spacelab/provider.ts.
SPACELAB_MODEL_PROVIDER=mock

# Key for whichever service is chosen. NOT NEEDED for the mock.
# PLACEHOLDER: paste the key once Matthew picks a provider, and set
# SPACELAB_MODEL_PROVIDER to match.
MESHY_API_KEY=
TRIPO_API_KEY=

# Public Supabase Storage bucket for generated GLBs. Without it, meshes are
# rebuilt per request by /api/spacelab/models — fine for the mock, WRONG for a
# paid provider (it would re-bill every fetch). Create a PUBLIC bucket named
# below, then paste its name here.
SPACELAB_ASSET_BUCKET=

# Set to 'off' to stop checkout from pre-generating models for an order. Worth
# doing once a paid provider is wired and generation should be user-initiated.
SPACELAB_PREWARM=on

# ---------------------------------------------------------------------------
# Dashboard · project paperwork folders
# ---------------------------------------------------------------------------

# PRIVATE Supabase Storage bucket holding files uploaded into a project's
# Paperwork folder (COIs, W9s, invoices, call sheets). The migration
# 20260902120000_project_folders.sql creates a bucket named 'paperwork'; set
# this only if your environment names it differently. Downloads go through
# short-lived signed URLs minted server-side, never a public URL.
PAPERWORK_BUCKET=paperwork
