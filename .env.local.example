# Copy to .env.local and fill in.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model. Defaults to openai/gpt-4o-mini.
# Cheap/fast picks: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: shown to OpenRouter for analytics / rate-limit attribution.
OPENROUTER_SITE_URL=http://localhost:3017
OPENROUTER_APP_NAME=prop-haus
